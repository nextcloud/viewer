{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "Europe/Berlin",
  "schedule": [
    "every weekend"
  ],
  "reviewers": [
    "skjnldsv"
  ],
  "labels": [
    "dependencies",
    "3. to review"
  ],
  "rangeStrategy": "bump",
  "rebaseWhen": "conflicted",
  "ignoreUnstable": false,
  "baseBranchPatterns": [
    "stable35",
    "stable34",
    "stable33",
    "stable32"
  ],
  "enabledManagers": [
    "npm"
  ],
  "ignoreDeps": [
    "node",
    "npm"
  ],
  "lockFileMaintenance": {
    "enabled": false
  },
  "packageRules": [
    {
      "groupName": "playwright",
      "matchPackageNames": [
        "/^@playwright//",
        "/playwright/"
      ]
    },
    {
      "groupName": "nextcloud",
      "matchPackageNames": [
        "/^@nextcloud//"
      ]
    },
    {
      "groupName": "dockerode",
      "matchPackageNames": [
        "@types/dockerode",
        "dockerode"
      ]
    },
    {
      "groupName": "typescript",
      "matchPackageNames": [
        "tslib",
        "typescript"
      ]
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "matchBaseBranches": [
        "stable35",
        "stable34",
        "stable33",
        "stable32"
      ],
      "enabled": false
    },
    {
      "matchPackageNames": [
        "vue"
      ],
      "allowedVersions": "<3"
    },
    {
      "description": "@nextcloud/vite-config 1.7 requires vite 7",
      "matchPackageNames": [
        "@nextcloud/vite-config"
      ],
      "matchBaseBranches": [
        "stable32"
      ],
      "allowedVersions": "<1.7"
    },
    {
      "description": "@nextcloud/stylelint-config 3.2 requires stylelint 17",
      "matchPackageNames": [
        "@nextcloud/stylelint-config"
      ],
      "matchBaseBranches": [
        "stable32"
      ],
      "allowedVersions": "<3.2"
    }
  ]
}
