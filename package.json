{
  "name": "viewer",
  "version": "6.0.0-dev.0",
  "private": true,
  "description": "Simple file viewer with slideshow for media",
  "keywords": [
    "nextcloud",
    "files",
    "viewer",
    "slideshow",
    "modal",
    "gallery"
  ],
  "homepage": "https://github.com/nextcloud/viewer",
  "bugs": {
    "url": "https://github.com/nextcloud/viewer/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nextcloud/viewer.git"
  },
  "license": "AGPL-3.0-or-later",
  "author": "John Molakvoæ <skjnldsv@protonmail.com>",
  "contributors": [
    "John Molakvoæ <skjnldsv@protonmail.com>"
  ],
  "type": "module",
  "scripts": {
    "build": "vite --mode production build",
    "dev": "export NODE_ENV=development; vite --mode development build",
    "lint": "eslint src test playwright",
    "lint:fix": "eslint src test playwright --fix",
    "playwright": "npx playwright test",
    "playwright:install": "npx playwright install",
    "playwright:start-nextcloud": "node playwright/start-server.mjs",
    "stylelint": "stylelint 'src/**/*.{css,scss,vue}'",
    "stylelint:fix": "stylelint 'src/**/*.{css,scss,vue}' --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "ts:check": "vue-tsc --noEmit",
    "watch": "export NODE_ENV=development; vite --mode development build --watch"
  },
  "browserslist": [
    "extends @nextcloud/browserslist-config"
  ],
  "dependencies": {
    "@fontsource/roboto": "^5.2.9",
    "@mdi/svg": "^7.4.47",
    "@nextcloud/auth": "^2.5.3",
    "@nextcloud/axios": "^2.5.2",
    "@nextcloud/dialogs": "^7.1.0",
    "@nextcloud/eslint-config": "^9.0.0-rc.5",
    "@nextcloud/event-bus": "^3.3.3",
    "@nextcloud/files": "^4.0.0",
    "@nextcloud/image-editor": "^1.0.0-beta.2",
    "@nextcloud/initial-state": "^3.0.0",
    "@nextcloud/l10n": "^3.4.1",
    "@nextcloud/logger": "^3.0.2",
    "@nextcloud/paths": "^2.3.0",
    "@nextcloud/router": "^3.1.0",
    "@nextcloud/typings": "^1.10.0",
    "@nextcloud/vue": "^9.3.0",
    "@skjnldsv/vue-plyr": "^7.5.0",
    "camelcase": "^9.0.0",
    "debounce": "^3.0.0",
    "dompurify": "^3.3.0",
    "nextcloud-server": "^0.15.10",
    "path-parse": "^1.0.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-konva": "^18.2.10",
    "vue": "^3.5.25",
    "vue-async-computed": "^4.0.1",
    "vue-material-design-icons": "^5.3.1",
    "webdav": "^5.8.0"
  },
  "devDependencies": {
    "@nextcloud/browserslist-config": "^3.1.2",
    "@nextcloud/e2e-test-server": "^0.5.0",
    "@nextcloud/sharing": "^0.3.0",
    "@nextcloud/stylelint-config": "^3.1.1",
    "@nextcloud/vite-config": "^2.5.2",
    "@playwright/test": "^1.61.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^3.2.7",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.8.1",
    "happy-dom": "^20.11.12",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "vite-plugin-static-copy": "^3.1.4",
    "vitest": "^3.2.7",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": "^24.0.0",
    "npm": "^11.3.0"
  }
}
